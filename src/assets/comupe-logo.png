<script src="https://www.comupe.org/wp-content/themes/amupe/js/jquery-ui.js"></script>
<script src="https://www.comupe.org/wp-content/themes/amupe/js/seletor-cidades.js"></script>
<script>
    $('div.dropdown-cidades').on('click', function(event) {
        event.stopPropagation();
    });
    $(function() {
        $("#tabs").tabs();
        $("#tabs2").tabs();
    });
    var limitWidth;
    var width = $(window).width();
    if (width >= 1200) {
        limitWidth = 6;
    } else if (width >= 992) {
        limitWidth = 9;
    } else if (width >= 768) {
        limitWidth = 12;
    } else {
        limitWidth = 6;
    }
    var feed = new Instafeed({
        get: 'user',
        userId: '2211047117',
        template: '<a target="_blank" href="{{link}}"><img class="instagram-photo" src="{{image}}" /></a>',
        limit: limitWidth,
        accessToken: '2211047117.1677ed0.bfcb18cf12c149149268436f0f906165'
    });
    feed.run();
    $(document).on('click', '.anchor', function(event) {
        event.preventDefault();
        $('html, body').animate({
            scrollTop: $($.attr(this, 'href')).offset().top
        }, 500);
    });

    $(window).scroll(function() {
        var scroll = $(window).scrollTop();
        if (scroll >= 500) {
            $(".backtop-link").addClass("show");
        } else {
            $(".backtop-link").removeClass("show");
        }
    });

    $('#lista-de-cidades-regiao').append($('#lista-de-cidades').html());

    $('#lista-de-cidades-regiao').append('<div class="clearfix"></div><!-- end .clearfix -->');
    
</script>
<script>
    var myLatLng = {lat: -8.0759169, lng: -34.9366942};
    function initMap() {
        // Specify features and elements to define styles.
        var styleArray = [
            {
                featureType: "all",
                stylers: [
                    {saturation: -80}
                ]
            }, {
                featureType: "road.arterial",
                elementType: "geometry",
                stylers: [
                    {hue: "#00ffee"},
                    {saturation: 50}
                ]
            }, {
                featureType: "poi.business",
                elementType: "labels",
                stylers: [
                    {visibility: "off"}
                ]
            }
        ];
        var myOptions = {
            center: myLatLng,
            scrollwheel: false,
            styles: styleArray,
            zoom: 15
        }
        // Create a map object and specify the DOM element for display.
        var map = new google.maps.Map(document.getElementById('map'), myOptions);
        var marker = new google.maps.Marker({
            map: map,
            position: myLatLng,
            title: 'AMUPE - Associação Municipalista de Pernambuco',
        });

    }
    $("#active-calendar-agenda").on('click', function(){
        $("#calendario_home").fadeToggle(300, "linear");
    });
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyABVxmXvEpcnMpu5iuIiL96nehV4HrGtzg&signed_in=true&callback=initMap"  async defer></script>


